# Materials Studio Generated CAR File

units             real
atom_style        full
boundary          p p p
 
pair_style        lj/cut/coul/long 10.0 12.0
pair_modify       mix arithmetic
bond_style        harmonic
angle_style       harmonic
dihedral_style    charmm
improper_style    harmonic
kspace_style      pppm 1.0e-4

read_data         TbHz.data

group cof         type 1 2 3
group water       type 4 5
group ow          type 4
group hw          type 5
group li          type 6
group cl          type 7
group mg          type 8
group liquid      type 4 5 6 7 8
group freeze      type 1 2 3

neighbor          2.0 bin

# ----------------------------------------------------------------------
restart           100000 restart.1 restart.2

timestep          1.0

# ---------------------------- Minimization ----------------------------
thermo            10
thermo_style      custom step cpu etotal
thermo_modify     flush yes
fix               freeze_min freeze setforce  0.0  0.0  0.0
minimize          1.0e-5 1.0e-5 1000 1000
# ---------------------------- Equilibrium -----------------------------
unfix             freeze_min
velocity          liquid create 300.0 1491119213 mom yes rot yes dist gaussian

variable          n equal z[6337]
fix               8 all colvars TbHz.colvars

thermo 	          1000
thermo_style      custom step cpu temp v_n
thermo_modify     flush yes

dump              1 all custom 100000 equilibrium.lammpstrJ id type x y z
dump_modify       1 sort id

fix               1 water shake 1e-5 2000 0 b 5 a 8
fix               7 liquid nvt temp 300.0 300.0 100.0

run               80000000