# Materials Studio Generated CAR File
# Three independent simulations using the same TbHz.data file
# COF atoms are frozen during both minimization and production dynamics.

variable          runid index 2 3
variable          seed  index 8374921 57382917

label             loop_three_seeds

# Reinitialize LAMMPS before every independent simulation.
clear

log               log.TbHz.frozenCOF.run${runid}.seed${seed}

print             "============================================================"
print             "Starting frozen-COF run ${runid} with random seed ${seed}"
print             "All runs read the same data file: TbHz.data"
print             "============================================================"

units             real
atom_style        full
boundary          p p p

pair_style        lj/cut/coul/long 10.0 12.0
pair_modify       mix arithmetic
bond_style        harmonic
angle_style       harmonic
dihedral_style    charmm
improper_style    harmonic
kspace_style      pppm 1.0e-4

# The same data file is read again during every loop iteration.
read_data         TbHz.data

region            lt block EDGE EDGE EDGE EDGE EDGE 39.803101
region            rt block EDGE EDGE EDGE EDGE 53.043098 EDGE
region            memb block EDGE EDGE EDGE EDGE 39.803101 53.043098
region            pump block EDGE EDGE EDGE EDGE 10 20
region            tot block EDGE EDGE EDGE EDGE EDGE EDGE

group             cof type 1 2 3
group             water type 4 5
group             ow type 4
group             hw type 5
group             li type 6
group             cl type 7
group             mg type 8
group             liquid type 4 5 6 7 8
group             freeze type 1 2 3

neighbor          2.0 bin

compute           watertemp water temp/region memb
compute           all_temp liquid temp/com

variable          mw equal count(ow,memb)
variable          mli equal count(li,memb)
variable          mcl equal count(cl,memb)
variable          mmg equal count(mg,memb)

variable          fw equal 100*0.108091375/(count(ow,pump)+6.941/16*count(li,pump)+35.4527/16*count(cl,pump)+24.305/16*count(mg,pump))
variable          fli equal 6.941/16*v_fw
variable          fcl equal 35.4527/16*v_fw
variable          fmg equal 24.305/16*v_fw

# Run-specific output names prevent the three simulations from overwriting files.
restart           1000 restart.frozenCOF.run${runid}.seed${seed}.1 restart.frozenCOF.run${runid}.seed${seed}.2

timestep          1.0

# ---------------------------- Minimization ----------------------------

thermo            10
thermo_style      custom step cpu etotal
thermo_modify     flush yes
fix               freeze_min freeze setforce 0.0 0.0 0.0
minimize          1.0e-5 1.0e-5 1000 1000

# Replace the minimization freeze with an explicitly named production freeze.
unfix             freeze_min

# ------------------------- Production dynamics ------------------------

# Only liquid atoms receive random velocities.  COF velocities remain zero.
velocity          liquid create 300.0 ${seed} mom yes rot yes dist gaussian

thermo            1000
thermo_style      custom step cpu c_watertemp c_all_temp v_fw v_mw v_mli v_mcl v_mmg
thermo_modify     flush yes

dump              1 all custom 10000 equilibrium.frozenCOF.run${runid}.seed${seed}.lammpstrj id type x y z
dump_modify       1 sort id

fix               1 water shake 1e-5 2000 0 b 5 a 8
fix               2 ow addforce 0.0 0.0 v_fw region pump
fix               4 li addforce 0.0 0.0 v_fli region pump
fix               5 cl addforce 0.0 0.0 v_fcl region pump
fix               6 mg addforce 0.0 0.0 v_fmg region pump

# Only liquid atoms are integrated and thermostatted.
fix               7 liquid nve
fix               8 liquid temp/berendsen 300.0 300.0 100.0
fix_modify        8 temp all_temp

run               120000000

print             "Completed frozen-COF run ${runid} with random seed ${seed}"

next              runid seed
jump              SELF loop_three_seeds
